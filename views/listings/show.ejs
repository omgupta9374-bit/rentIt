
<% layout("/layouts/boilerplate") %>

<div class="row mt-3">

    <!-- Listing Heading -->
    <div class="col-8 offset-2">
        <h3>Listing Details</h3>
    </div>

    <!-- Listing Card -->
    <div class="card col-6 offset-3 show-card">

        <!-- Listing Image -->
        <% if (listing.image && listing.image.url) { %>
            <img
                src="<%= listing.image.url %>"
                class="card-img-top show-img"
                alt="<%= listing.title %>"
            />
        <% } %>

        <!-- Listing Details -->
        <div class="card-body">
            <p class="card-text">

                <b><%= listing.title %></b>
                <br />

                <%= listing.description || "No description available" %>
                <br />

                &#8377;
                <%= listing.price != null
                    ? listing.price.toLocaleString("en-IN")
                    : "Price not provided" %>
                <br />

                <%= listing.location || "Location not provided" %>
                <br />

                <%= listing.country || "Country not provided" %>

            </p>
        </div>
    </div>

    <!-- Edit and Delete Buttons -->
    <div class="btns mt-3">

        <!-- Edit -->
        <a
            href="/listings/<%= listing._id %>/edit"
            class="btn btn-dark col-1 offset-2 edit-btn"
        >
            Edit
        </a>

        <!-- Delete -->
        <form
            method="POST"
            action="/listings/<%= listing._id %>?_method=DELETE"
            class="d-inline"
        >
            <button
                class="btn btn-dark offset-4"
                type="submit"
            >
                Delete
            </button>
        </form>

    </div>

    <!-- Review Form -->
    <div class="col-8 offset-2 mt-5">

        <hr />

        <h4 class="mb-3">Leave a Review</h4>

        <form
            action="/listings/<%= listing._id %>/reviews"
            method="POST"
        >

            <!-- Rating -->
            <div class="mb-3">
                <label for="rating" class="form-label">
                    Rating (1-5)
                </label>

                <input
                    type="number"
                    name="review[rating]"
                    id="rating"
                    class="form-control"
                    min="1"
                    max="5"
                    required
                />
            </div>

            <!-- Comment -->
            <div class="mb-3">
                <label for="comment" class="form-label">
                    Comment
                </label>

                <textarea
                    name="review[comment]"
                    id="comment"
                    class="form-control"
                    rows="3"
                    placeholder="Write your review..."
                    required
                ></textarea>
            </div>

            <!-- Submit -->
            <button type="submit" class="btn btn-dark">
                Submit Review
            </button>

        </form>

        <hr class="mt-5" />

        <!-- All Reviews -->
        <div class="col-8 offset-2 mt-5">

    <h4>Customer Reviews</h4>
    <hr>

    <% if (listing.reviews && listing.reviews.length > 0) { %>

        <% listing.reviews.forEach((review) => { %>

            <div class="card mb-3">
                <div class="card-body">

                    <h5>
                        Rating: <%= review.rating %>/5 ⭐
                    </h5>

                    <p>
                        Comment: <%= review.comment %>
                    </p>

                    <small class="text-muted">
                        <%= review.createdAt
                            ? review.createdAt.toDateString()
                            : "Date unavailable" %>
                    </small>

                </div>
            </div>

        <% }) %>

    <% } else { %>

        <p>No reviews yet!</p>

    <% } %>

</div>
    </div>

</div>
