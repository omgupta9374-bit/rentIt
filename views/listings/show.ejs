
<% layout("/layouts/boilerplate") %>

<div class="row mt-3">
    <div class="col-8 offset-2">
        <h3>Listing Details</h3>
    </div>

    <div class="card col-6 offset-3 show-card">

        <% if (listing.image && listing.image.url) { %>
            <img
                src="<%= listing.image.url %>"
                class="card-img-top show-img"
                alt="<%= listing.title %>"
            />
        <% } else if (typeof listing.image === "string" && listing.image) { %>
            <img
                src="<%= listing.image %>"
                class="card-img-top show-img"
                alt="<%= listing.title %>"
            />
        <% } %>

        <div class="card-body">
            <p class="card-text">
                <b><%= listing.title %></b>
                <br />

                <%= listing.description || "No description available" %>
                <br />

                &#8377;
                <%= listing.price != null
                    ? listing.price.toLocaleString("en-IN")
                    : "Price not provided" %>
                <br />

                <%= listing.location || "Location not provided" %>
                <br />

                <%= listing.country || "Country not provided" %>
            </p>
        </div>
    </div>

    <br />

    <div class="btns">
        <a
            href="/listing/<%= listing._id %>/edit"
            class="btn btn-dark col-1 offset-2 edit-btn"
        >Edit</a>

        <form
            method="POST"
            action="/listing/<%= listing._id %>?_method=DELETE"
        >
            <button class="btn btn-dark offset-4" type="submit">
                Delete
            </button>
        </form>
    </div>
</div>
